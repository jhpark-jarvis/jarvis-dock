{
  "name": "jarvis-dock",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "dev": "npm run start --workspace=@jarvis-dock/desktop",
    "start": "npm run start --workspace=@jarvis-dock/desktop",
    "typecheck": "npm run typecheck --workspace=@jarvis-dock/desktop",
    "lint": "npm run lint --workspace=@jarvis-dock/desktop",
    "format": "npm run format --workspace=@jarvis-dock/desktop",
    "format:check": "npm run format:check --workspace=@jarvis-dock/desktop",
    "test:unit": "npm run test:unit --workspace=@jarvis-dock/desktop",
    "test:unit:watch": "npm run test:unit:watch --workspace=@jarvis-dock/desktop",
    "test:e2e": "npm run test:e2e --workspace=@jarvis-dock/desktop",
    "test:e2e:watch": "npm run test:e2e:watch --workspace=@jarvis-dock/desktop",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit",
    "package": "npm run package --workspace=@jarvis-dock/desktop",
    "make": "npm run make --workspace=@jarvis-dock/desktop",
    "publish": "npm run publish --workspace=@jarvis-dock/desktop"
  }
}
